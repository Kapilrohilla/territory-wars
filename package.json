{
  "name": "territory-wars",
  "version": "1.0.0",
  "description": "Territory Wars: an original browser territory-capture game.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run --dir tests",
    "bench": "vitest run --dir bench --silent=false",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run build && cap sync android && cap run android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor '#f8f7f3' --splashBackgroundColor '#e4e2dc'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kapilrohilla/paper-io-clone.git"
  },
  "keywords": [],
  "author": "kapil rohilla <kapil.rohilla@carrum.co.in>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Kapilrohilla/paper-io-clone/issues"
  },
  "homepage": "https://github.com/Kapilrohilla/paper-io-clone#readme",
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource/nunito-sans": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "polygon-clipping": "^0.15.7"
  },
  "type": "module"
}
